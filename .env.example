# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env yang berisi nilai sebenarnya.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carewell_clinic

PORT=3000

# Ganti dengan string acak yang kuat, contoh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-acak-yang-kuat
JWT_EXPIRES_IN=7d
